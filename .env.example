# ==============================================================================
# MASTER PROJECT — Environment Template (.env.example)
# คัดลอกไฟล์นี้เป็น .env.local แล้วกำหนดค่าตามสภาพแวดล้อมจริง
# ==============================================================================

APP_NAME=master-project
SESSION_SECRET=replace-with-at-least-32-bytes-random-hex
USE_HTTPS=false
UPLOAD_BASE_DIR=D:/master-project

# Oracle Database
ORACLE_HOST=10.252.90.55
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=msddbc1
ORACLE_SCHEMA=RPP
ORACLE_CLIENT_LIB_PATH=C:\oracle\instantclient_21_18
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# MySQL — Main DB
DB_HOST=10.5.55.253
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=procurement_db
DB_CONNECTION_LIMIT=10

# MySQL — e-GP DB
EGP_DB_NAME=egp_db
EGP_DB_CONNECTION_LIMIT=10

# MySQL — Purchase / Budget DB
PURCHASE_DB_HOST=10.5.55.253
PURCHASE_DB_PORT=3306
PURCHASE_DB_USER=your_mysql_user
PURCHASE_DB_PASSWORD=your_mysql_password
PURCHASE_DB_NAME=purchase_db
PURCHASE_DB_CONNECTION_LIMIT=10

# MySQL — Inventory DB
INVENTORY_DB_NAME=inventory
INVENTORY_DB_CONNECTION_LIMIT=10

# MySQL — GOTOWIN DB
GOTOWIN_DB_HOST=45.154.27.240
GOTOWIN_DB_PORT=15301
GOTOWIN_DB_USER=your_gotowin_user
GOTOWIN_DB_PASSWORD=your_gotowin_password
GOTOWIN_DB_NAME=bo_customer_14641
GOTOWIN_DB_CONNECTION_LIMIT=10

# Active Directory / LDAP
LDAP_URL=ldaps://192.168.238.8
LDAP_BASE_DN=DC=rpphosp,DC=local
LDAP_BIND_DN=ldaprpp@rpphosp.local
LDAP_BIND_PASSWORD=your_ldap_password

# SMTP Email
SMTP_HOST=mail.rpphosp.go.th
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@rpphosp.go.th
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@rpphosp.go.th
